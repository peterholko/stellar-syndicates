# Rust
/target
**/*.rs.bk

# Node / client
node_modules/
client/dist/
client/node_modules/

# Local dev Postgres cluster (scripts/devdb.sh)
/.devdb/

# RAM-authoritative galaxy checkpoints and recoverable resets
/saves/

# Env / secrets
.env
.env.local

# Editor / OS
.DS_Store
.idea/
.vscode/

# Claude Code workflow worktrees / scratch
.claude/worktrees/

# Local dev server logs
server*.log

# Scratch output (image generation, captures, temp files)
/output/
/tmp/

# Ship-model deliveries kept on disk only: archives (up to 333 MB, past
# GitHub's limit), bundled viewers, LOD experiments and Python caches
client/art-src/ship-models/**/*.zip
client/art-src/ship-models/**/viewer.html
client/art-src/ship-models/*lod-experiment*/
client/art-src/ship-models/**/__pycache__/
client/art-src/ship-models/**/*.pyc
