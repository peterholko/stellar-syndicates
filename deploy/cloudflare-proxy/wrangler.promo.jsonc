{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stellar-syndicates-promo",
  "account_id": "514db0d52efacfc2b7d0c685d7b57cf6",
  "main": "src/promo.ts",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "promo.stellarsyndicates.com", "custom_domain": true }],
  "assets": {
    "directory": "./promo-public",
    "binding": "ASSETS",
    "run_worker_first": ["/video.mp4", "/stellar-syndicates-promo-v09-web.mp4"]
  },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "stellar-syndicates-promo" }],
  "vars": { "PROMO_VIDEO_KEY": "stellar-syndicates-promo-v09-web.mp4" },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
