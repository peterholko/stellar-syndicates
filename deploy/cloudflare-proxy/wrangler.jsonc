{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stellar-syndicates-gateway",
  "account_id": "514db0d52efacfc2b7d0c685d7b57cf6",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // §front-door (docs/front-door.md): the front page and the game client.
  // www and play.stellarsyndicates.com are wrangler.play.jsonc's.
  "routes": [
    {
      "pattern": "stellarsyndicates.com",
      "custom_domain": true
    }
  ],
  // Cloudflare serves every file of the client build; only /api/* (and paths
  // no file matches) run src/index.ts.
  "assets": {
    "directory": "../../client/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vpc_networks": [
    {
      "binding": "ORIGIN",
      "tunnel_id": "1cec1f7d-fbbf-4b76-b83e-1f44d62131ae",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
