{
  "name": "stellar-syndicates-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pixi.js client — renders the per-player delayed/fogged view. No authoritative state, no game logic.",
  "scripts": {
    "dev": "vite",
    "assets:derive": "node scripts/build-art-derivatives.mjs",
    "assets:ships:bake": "node scripts/bake-ship-model-art.mjs",
    "assets:hardpoints": "node scripts/build-ship-hardpoints.mjs",
    "test:ship-models": "node scripts/test-ship-models.mjs && npm run test:ship-art",
    "preview:ship-models": "vite --host 127.0.0.1 --port 8781 --strictPort --open /scripts/ship-model-fixture.html",
    "assets:stars": "node scripts/build-star-derivatives.mjs",
    "assets:planets": "node scripts/build-planet-derivatives.mjs",
    "assets:sites": "node scripts/build-planet-sites.mjs",
    "assets:surface-structures": "node scripts/build-planet-surface-structure-art.mjs",
    "assets:hub": "node scripts/build-hub-model-assets.mjs",
    "assets:hub:bake": "node scripts/bake-hub-model-art.mjs",
    "assets:glyphs": "node scripts/build-map-glyphs.mjs",
    "build": "npm run assets:derive && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:wire": "node scripts/test-wire.mjs && node scripts/test-net.mjs",
    "test:accounts": "node scripts/test-accounts.mjs && node scripts/test-net.mjs",
    "test:battlefire": "node scripts/test-battlefire.mjs",
    "test:battle-models": "node scripts/test-battle-models.mjs && npm run test:battle-fx && npm run test:battle-wrecks && npm run test:battlefire && npm run test:battle-backdrop",
    "test:battle-wrecks": "node scripts/test-battle-wrecks.mjs",
    "test:battle-fx": "node scripts/test-battle-fx.mjs",
    "test:battle-backdrop": "node scripts/test-battle-backdrop.mjs",
    "test:progression": "node scripts/test-progression.mjs",
    "test:settlement": "node scripts/test-settlement.mjs",
    "test:industry": "node scripts/test-industry.mjs && node scripts/test-industrial-expansion.mjs",
    "test:ores": "node scripts/test-ore-economy.mjs",
    "test:exploration": "node scripts/test-exploration.mjs",
    "test:equipment": "node scripts/test-equipment.mjs",
    "test:blockade": "node scripts/test-blockade.mjs",
    "test:combat-preparation": "node scripts/test-combat-preparation.mjs",
    "test:transactions": "node scripts/test-transactions.mjs",
    "test:market-workbench": "node scripts/test-market-workbench.mjs",
    "test:research-workbench": "node scripts/test-research-workbench.mjs",
    "test:order-confirmation": "node scripts/test-order-confirmation.mjs",
    "test:order-response-clock": "node scripts/test-order-response-clock.mjs",
    "test:map-ship-sizes": "node scripts/test-map-ship-sizes.mjs",
    "test:map-zoom": "node scripts/test-map-zoom.mjs && node scripts/test-map-ship-sizes.mjs && node scripts/test-map-hub-size.mjs && node scripts/test-star-rendering.mjs",
    "test:map-ship-models": "node scripts/test-map-ship-models.mjs && npm run test:ship-art",
    "test:ship-art": "node scripts/test-ship-art.mjs && node scripts/test-map-ship-sizes.mjs",
    "test:map-hub-size": "node scripts/test-map-hub-size.mjs",
    "test:star-art": "node scripts/test-star-art.mjs && node scripts/test-star-rendering.mjs",
    "test:planet-art": "node scripts/test-planet-art.mjs && node scripts/test-planet-surfaces.mjs && node scripts/test-battle-backdrop.mjs",
    "test:planet-surfaces": "node scripts/test-planet-surfaces.mjs",
    "test:planet-panel": "node scripts/test-planet-panel.mjs",
    "test:orbital-shipyards": "node scripts/test-orbital-shipyard-art.mjs && node scripts/test-planet-panel.mjs && node scripts/test-industry.mjs",
    "test:structure-art": "node scripts/test-structure-art.mjs",
    "test:surface-structures": "node scripts/test-planet-surface-structure-art.mjs && node scripts/test-planet-panel.mjs",
    "test:command-centers": "node scripts/test-command-centers.mjs && node scripts/test-planet-panel.mjs && node scripts/test-structure-art.mjs",
    "test:fleet-lists": "node scripts/test-fleet-lists.mjs",
    "test:fleet-panel": "node scripts/test-fleet-panel.mjs",
    "test:hub-model": "node scripts/test-hub-model.mjs && node scripts/test-map-hub-size.mjs",
    "test:map-markers": "node scripts/test-map-markers.mjs && node scripts/test-exploration.mjs",
    "test:system-defense": "node scripts/test-system-defense.mjs",
    "test:system-view": "node scripts/test-system-view.mjs",
    "test:live-battle": "node scripts/test-live-battle.mjs && node scripts/test-battle-history.mjs && node scripts/test-battle-aftermath.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3",
    "pixi.js": "^8.19.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  }
}
