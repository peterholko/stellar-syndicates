# §front-door (docs/front-door.md): Cloudflare serves the client. Vite names
# these files by content hash, so they never change in place.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# §client-updates (docs/client-updates.md): the newest build's stamp, which
# open tabs check; never cached.
/version.json
  Cache-Control: no-store
